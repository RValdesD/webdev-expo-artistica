{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "tests",
    "src/**/*.test.ts"
  ],
  "files": [
    "src/index.ts",
    "src/seed.ts",
    "src/seedExhibitions.ts",
    "src/setUserRole.ts",
    "src/createAdmin.ts"
  ]
}
