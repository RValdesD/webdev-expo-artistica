MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DBNAME=art_expo
PORT=3001
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret
# Dominio de los correos de organizador (las cuentas se crean con npm run user:create-admin)
ADMIN_EMAIL_DOMAIN=admin.expo.cl
# Orígenes extra que pueden iniciar sesión, separados por coma (ej: la URL del frontend desplegado)
ALLOWED_ORIGINS=
