# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repositorio.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=expo_artistica
PORT=3001

# Base aparte para los tests: npm test la vacía en cada ejecución
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
TEST_MONGODB_DB_NAME=expo_artistica_test

# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
